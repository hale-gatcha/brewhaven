<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net9.0-windows</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<ApplicationTitle>Brew Haven Coffee Shop (Walk-In)</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
	<PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
	<None Update="App.config"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
	<None Update="logo.jpeg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
	<None Update="Fonts\*.ttf"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
	<None Update="Fonts\OFL.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
